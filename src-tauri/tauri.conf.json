{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cephalon Merlin",
  "version": "0.2.1",
  "identifier": "de.tvmerlintv.cephalonmerlin.rs",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Cephalon Merlin",
        "width": 1480,
        "height": 900,
        "minWidth": 980,
        "minHeight": 620,
        "decorations": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#0f1219"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
